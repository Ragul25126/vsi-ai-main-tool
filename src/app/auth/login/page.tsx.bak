        /* ── Responsive: Mobile ── */
        @media (max-width: 768px) {
          .lp-inner {
            flex-direction: column;
            align-items: stretch;
          }
          .lp-left {
            flex: none;
            max-width: 100%;
            padding: 2rem 1.25rem 1.5rem;
          }
          .lp-logo { margin-bottom: 1.5rem; }
          .lp-features { display: none; }
          .lp-stats {
            grid-template-columns: repeat(2, 1fr);
            margin-bottom: 0;
          }
          .lp-right {
            flex: none;
            max-width: 100%;
            padding: 1.25rem 1rem 2.5rem;
          }
          .lp-right::before { display: none; }
          .login-card {
            max-width: 100%;
            padding: 1.75rem 1.25rem;
            border-radius: 16px;
          }
          .lp-heading { font-size: 1.65rem; margin-bottom: 0.75rem; }
          .lp-desc { font-size: 0.85rem; margin-bottom: 1.25rem; }
          .lp-stats { margin-bottom: 0; }
          .lp-stat + .lp-stat { border-left: none; }
          .lp-stat:nth-child(2) { border-left: 1px solid rgba(255,255,255,0.07); }
          .lp-stat:nth-child(3) { border-top: 1px solid rgba(255,255,255,0.07); border-left: none; }
          .lp-stat:nth-child(4) {
            border-top: 1px solid rgba(255,255,255,0.07);
            border-left: 1px solid rgba(255,255,255,0.07);
          }
        }
      `}</style>

      <div className="lp-root">
        {/* Ambient particles */}
        <div className="lp-particle lp-p1" />
        <div className="lp-particle lp-p2" />
        <div className="lp-particle lp-p3" />
        <div className="lp-particle lp-p4" />

        <div className="lp-inner">
          {/* ── LEFT PANEL ── */}
          <div className="lp-left">
            {/* Logo */}
            <div className="lp-logo">
              <Image
                src="/vg-logo.png"
                alt="VSI ValGrow logo"
                width={38}
                height={38}
                className="lp-logo-img"
                onError={(e) => {
                  (e.target as HTMLImageElement).style.display = "none";
                }}
              />
              <div className="lp-logo-text">
                <span className="lp-logo-vsi">VSI</span>
                <span className="lp-logo-sub">ValGrow</span>
              </div>
            </div>

            {/* Badge */}
            <div className="lp-badge">
              <span className="lp-badge-dot" />
              <span className="lp-badge-text">
                ValGrow Search Intelligence • GEO Platform
              </span>
            </div>

            {/* Heading */}
            <h1 className="lp-heading">
              Dominate AI Search
              <br />
              Before Your
              <br />
              <span className="lp-heading-accent">Competitors Do</span>
            </h1>

            {/* Description */}
            <p className="lp-desc">
              Monitor how AI platforms mention your brand, discover competitor
              opportunities, optimize your content for AI search, and increase
              visibility where modern buyers search first.
            </p>

            {/* Features */}
            <div className="lp-features">
              {features.map((f) => (
                <div key={f.title} className="lp-feature">
                  <div className="lp-feature-icon">
                    <f.icon size={18} />
                  </div>
                  <div className="lp-feature-info">
                    <span className="lp-feature-title">{f.title}</span>
                    <span className="lp-feature-desc">{f.desc}</span>
                  </div>
                </div>
              ))}
            </div>

            {/* Stats */}
            <div className="lp-stats">
              {stats.map((s) => (
                <div key={s.label} className="lp-stat">
                  <span className="lp-stat-value">{s.value}</span>
                  <span className="lp-stat-label">{s.label}</span>
                </div>
              ))}
            </div>
          </div>

          {/* ── RIGHT PANEL ── */}
          <div className="lp-right">
            <Suspense
              fallback={
                <div className="login-card">
                  <div
                    style={{
                      textAlign: "center",
                      color: "#6b7280",
                      fontSize: "0.875rem",
                      padding: "2rem 0",
                    }}
                  >
                    Loading…
                  </div>
                </div>
              }
            >
              <LoginForm />
            </Suspense>
          </div>
        </div>
      </div>
    </>
  );
}
